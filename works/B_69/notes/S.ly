B-LXIXKyrieSoprano = {
  \relative c' {
    \clef treble
    \key c \major \time 3/2 \tempoB-LXIXKyrie \autoBeamOff
    \mvTr c'2.\fE^\tuttiE a4 f' d
    h c r c2_( h8[ a)]
    h[ c] d4 e2. d8[ c]
    d2. c8[ h] c4 d
    g, g c2._( h8[ a)] %5
    h2.( c4 d2)
    e d1
    d4 h2 g4 e' c~
    c h8([ a)] h4 h c d~
    d c8[ h] c2 r %10
    g2. e4 e' d8([ c)]
    d2 d2. c8[ h]
    c2 c2._( h8[ a)]
    h4 c2 h8[ a] h2
    c r r\fermata \bar "||" %15
    \time 4/4 \tempoB-LXIXChriste \newSpacingSection
      r8 \mvTr a4\pE^\soloE gis8 r c4 h8 \noBreak
    r g c4~ c8.[ d32 c] h4~
    h8.[ c32 h] a4~ a8.[ h32 a] gis8[ h]
    a gis16([ h)] a([ \hA gis] a8)] \hA gis4 r
    r2 r8 c4 h8 %20
    r d4 c8 r4 r8 e
    \sbOn \tuplet 3/2 8 { cis16[( h \hA cis e d \hA cis]) } d8 a \tuplet 3/2 8 { h16[ a h d c h] c[ h c e d c]
    h[ a h d c h] c[ d e e d c] d[ e f f e d] } \sbOff e[ d] e e
    e8 d r4 r2
    r r4 r8 a %25
    f'4~ f8.[\trill g32 f] e4~ e8.[\trill f32 e]
    d4~ d8.[\trill e32 d] c8.[\trill h32 c] d8 h
    \sbOn \tuplet 3/2 8 { c16[( d e f e d] } \sbOff c8[ h])\trill a4 r
    R1*2 \noBreak %30
    R1\fermata \markKyrieUtSupra \bar "||" %31 finis
  }
}

