\version "2.24.0"

A-IXScenaSecundaTenore = {
  \relative c' {
    \clef "treble_8"
    \key c \dorian \time 4/4 \autoBeamOff \tempoA-IXScenaSecundaA
    R1
    f2\fE r
    c4 r8 c des des des des
    c2 r4 r8 c
    b b b b b4 as8 as %5
    as([ b16 c] des4) g, r8 g
    a a b b c4 r8 c
    as as as as as([ g)] g4
    r as as a
    b4. b8 a!4 r8 a %10
    h h c c c([ h)] h4
    es r d r8 d
    es es des des c4. c8
    c4 b b8 b a a
    a2 g4 r %15
    \key c \major \tempoA-IXScenaSecundaB R1*5 %20
    \key c \dorian \tempoA-IXScenaSecundaA
      c4\fE r8 c b b f' f
    b,4 r8 es fes fes fes fes
    es4 r8 es es es es es
    d!4 r8 d b([ ges)] ges([ es)]
    es4 d es r %25
    \key c \major \tempoA-IXScenaSecundaB R1*4
    \key c \dorian \tempoA-IXScenaSecundaA
      as4\fE r8 \hA as g4 r8 g %30
    g g g g g([ f)] f4
    r8 a! a a h8. h16 g8 g
    as as as as g4 g
    r8 f g a g4. g8
    g4 r \tempoA-IXScenaSecundaB r2 %35
    R1*3
    \tempoA-IXScenaSecundaA r4 e'\fE a,8 a d d
    e4 e r8 a,\p a a %40
    a a a16([ g)] a8 b4 r8 b
    a d d d d8. d16 d8 d
    d d d d es!4 es8 es
    f f f f es c c d
    e4 a, a2 %45
    a4 r \tempoA-IXScenaSecundaB r2
    R1*6 %52
    \tempoA-IXScenaSecundaA d4\fE d8 d c4 f
    e r8 es es es es es
    es([ d)] d4 r8 es es b %55
    d4. d8 g,4 r8 es'
    e e e e f4 f
    r8 c c c as8. as16 as8 as
    b b as as as([ g)] g g
    c c c b b([ a)] a a %60
    h h c2 h4
    c4 r \tempoA-IXScenaSecundaB r2
    R1*7 %69
    \tempoA-IXScenaSecundaA r4 a\fE b8 b d b %70
    g4 g8 c c c d d
    d([ c)] c4 r2
    r r4 r8 f,
    f f f f b b b b
    b4 b r d %75
    d8 d f f, g4 g8 g
    as as a a a([ b)] b b
    c c c c b4. c8
    d! d a a g2
    g4 r \tempoA-IXScenaSecundaB r2 %80
    R1*4 \bar "||" %84 finis
  }
}

