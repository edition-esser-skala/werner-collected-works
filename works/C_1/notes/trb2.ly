C-IBenedictusTromboneII = {
  \relative c' {
    \clef tenor
    \key es \lydian \time 3/4 \tempoC-IBenedictus
      \once \override Staff.TimeSignature.style = #'single-digit
    R2.
    r8 \mvTr g\pE-\solo b( g) f( as)
    g4 r r
    R2.*2 %5
    f8( g) g( as) as( b)
    b2.
    as8( b) g4.\trill g8
    f4 r r
    R2.*5 %14
    b4. as16 g f g as8 %15
    g4 r r
    R2.*6 %22
    d'4 es16( d es8) f4
    b, r r
    R2.*8 %32
    r8 es, as( c) as( f)
    f d es2
    as4 g8( f) b4 %35
    g r r\fermata \markOsannaUtSupra \bar "||" %36 finis
  }
}

